apiVersion: 1

groups:
  - uid: system-resource-alerts
    orgId: 1
    name: "System Resource Alerts"
    folder: "Alerts"
    interval: 1m
    rules:
      # Disk Usage Alerts
      - uid: disk_usage_warning
        title: "Disk Usage > {{ grafana_alert_disk_yellow }}% (Warning)"
        condition: C
        for: 5m
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              intervalMs: 1000
              maxDataPoints: 43200
              expr: |
                100 * (
                  1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
                  / node_filesystem_size_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
                )
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ grafana_alert_disk_yellow }}]
                  operator:
                    type: and
        annotations:
          summary: "Disk usage warning on {{ '{{' }}$labels.instance{{ '}}' }}"
          description: "Root filesystem usage is {{ '{{' }}$values.B.Value | printf \"%.2f\"{{ '}}' }}% on {{ '{{' }}$labels.instance{{ '}}' }}"
        labels:
          severity: warning

      - uid: disk_usage_high
        title: "Disk Usage > {{ grafana_alert_disk_orange }}% (High)"
        condition: C
        for: 2m
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              intervalMs: 1000
              maxDataPoints: 43200
              expr: |
                100 * (
                  1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
                  / node_filesystem_size_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
