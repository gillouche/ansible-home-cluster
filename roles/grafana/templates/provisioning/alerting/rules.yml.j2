              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ grafana_alert_disk_orange }}]
                  operator:
                    type: and
        annotations:
          summary: "Disk usage high on {{ '{{' }}$labels.instance{{ '}}' }}"
          description: "Root filesystem usage is {{ '{{' }}$values.B.Value | printf \"%.2f\"{{ '}}' }}% on {{ '{{' }}$labels.instance{{ '}}' }}"
        labels:
          severity: warning

      - uid: disk_usage_critical
        title: "Disk Usage > {{ grafana_alert_disk_red }}% (Critical)"
        condition: C
        for: 1m
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              intervalMs: 1000
              maxDataPoints: 43200
              expr: |
                100 * (
                  1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
                  / node_filesystem_size_bytes{fstype!~"tmpfs|overlay",mountpoint="/"}
                )
          - refId: B
