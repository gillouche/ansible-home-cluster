apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://{{ grafana_prometheus_host }}:{{ grafana_prometheus_port }}
    uid: prometheus
    isDefault: true
    editable: true

  - name: Loki
    type: loki
    access: proxy
    url: http://{{ grafana_loki_host }}:{{ grafana_loki_port }}
    editable: true
