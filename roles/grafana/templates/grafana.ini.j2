[paths]
data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

[server]
protocol = http
http_addr = 0.0.0.0
http_port = 3000
domain = grafana.{{ base_domain }}
root_url = https://grafana.{{ base_domain }}
serve_from_sub_path = false

[security]
admin_user = {{ grafana_admin_user }}
{% if grafana_admin_password is defined %}
admin_password = {{ grafana_admin_password }}
{% endif %}

[auth]
disable_login_form = false

[auth.basic]
enabled = true

[auth.ldap]
enabled = false

[analytics]
check_for_updates = true

[log]
mode = console

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/prometheus-node-exporter.json
