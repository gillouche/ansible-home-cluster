apiVersion: templates.gatekeeper.sh/v1
kind: ConstraintTemplate
metadata:
  name: k8srequirenamespace
spec:
  crd:
    spec:
      names:
        kind: K8sRequireNamespace
  targets:
    - target: admission.k8s.gatekeeper.sh
      rego: |
        package k8srequirenamespace

        violation[{"msg": msg}] {
          input.review.object.kind != "Namespace"
          not input.review.object.metadata.namespace
          msg := "Namespaced resources must explicitly set metadata.namespace"
        }
---
apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sRequireNamespace
metadata:
  name: require-namespace
spec:
  enforcementAction: dryrun
  match:
    kinds:
      - apiGroups: [""]
        kinds: ["Pod", "Service", "ConfigMap", "Secret"]
      - apiGroups: ["apps"]
        kinds: ["Deployment", "StatefulSet", "DaemonSet"]
    namespaceSelector:
      matchExpressions:
        - key: policy-tier
          operator: In
          values: ["playground"]
    excludedNamespaces:
{% for ns in gatekeeper_excluded_namespaces %}
      - {{ ns }}
{% endfor %}
