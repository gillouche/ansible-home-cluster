vrrp_script check_caddy_proxy {
  script "/usr/bin/curl -k -s -o /dev/null -w '%{http_code}' https://127.0.0.1 | grep -E '(200|404|403|301|302)'"
  interval 5
  weight 20
  rise 2
  fall 2
}

vrrp_instance VI_ReverseProxy {
  state {{ vrrp_state }}
  interface {{ vrrp_interface }}
  virtual_router_id 52
  priority {{ vrrp_priority }}
  advert_int 1

  authentication {
    auth_type PASS
    auth_pass {{ vrrp_auth_pass }}
  }

  virtual_ipaddress {
    {{ vip_address }}/{{ vip_prefixlen | default(24) }}
  }

  track_interface {
    {{ vrrp_interface }}
  }

  track_script {
    check_caddy_proxy
  }
}
