{
    # Global options
    # Disable auto-HTTPS. We manage certificates externally via Ansible.
    auto_https off
}

{% if reverse_proxy_domains | default([]) | length > 0 %}
{{ reverse_proxy_domains | join(', ') }} {
    bind {{ reverse_proxy_bind_ip | default('0.0.0.0') }}

    # Load certificates from the host mount (container needs to mount these)
    # The role mount logic must match these paths.
    # We assume 'tls_target_dir' on host is mounted to /etc/tls/ in container or similar.
    # For now, let's use the explicit paths defined in defaults.
    tls {{ reverse_proxy_tls_cert_path }} {{ reverse_proxy_tls_key_path }}

    reverse_proxy {{ load_balancer_virtual_ip | default('192.168.0.253') }}:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote}
    }
}
{% else %}
:443 {
    bind {{ reverse_proxy_bind_ip | default('0.0.0.0') }}

    tls {{ reverse_proxy_tls_cert_path }} {{ reverse_proxy_tls_key_path }}

    reverse_proxy {{ load_balancer_virtual_ip | default('192.168.0.253') }}:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote}
    }
}
{% endif %}

# Redirect all HTTP to HTTPS
:80 {
    bind {{ reverse_proxy_bind_ip | default('0.0.0.0') }}
    redir https://{host}{uri} permanent
}
