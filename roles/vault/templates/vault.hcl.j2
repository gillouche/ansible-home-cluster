# Managed by Ansible - Vault server configuration

ui = true

cluster_name = "homelab-vault"

{#
  Use the effective public URL computed by the role (typically https://<IP>:8200)
  to avoid relying on base_domain/FQDN inside the container.
#}
api_addr = "{{ vault_public_url_effective }}"
{# Derive hostname/IP from public URL without relying on urlsplit (portable) #}
{% set _pub_host = (vault_public_url_effective | regex_replace('^https?://', '') | regex_replace(':\\d+/?$', '') | trim('/') ) %}
cluster_addr = "https://{{ _pub_host }}:{{ vault_cluster_port }}"

storage "raft" {
path    = "{{ vault_data_dir_in_container }}"

{#
    Build retry_join only on non-first nodes and target the first inventory
    node as the bootstrap leader. This avoids deadlocks where all nodes try to
    join each other simultaneously.
  #}
{% set first_node = (groups['vault_cluster'] | default([])) | length > 0 and (groups['vault_cluster'][0]) or inventory_hostname %}
{% if inventory_hostname != first_node %}
    retry_join {
    # Target the bootstrap node's API address (use IP to avoid DNS dependency)
    leader_api_addr       = "https://{{ hostvars[first_node].ansible_facts.default_ipv4.address | default(first_node) }}:{{ vault_api_port }}"
    # In initial bootstrap, skip TLS verification to avoid CA mismatch; tighten later
    leader_tls_servername = "{{ hostvars[first_node].ansible_facts.default_ipv4.address | default(first_node) }}"
    leader_tls_skip_verify = true
    }
{% endif %}
}

listener "tcp" {
address         = "{{ vault_listener_address | default(vault_bind_ip) }}:{{ vault_api_port }}"
tls_disable     = 0
tls_cert_file   = "{{ vault_tls_cert_path }}"
tls_key_file    = "{{ vault_tls_key_path }}"
}

telemetry {
prometheus_retention_time = "12h"
}

# Explicitly set disable_mlock to satisfy Vault >=1.20 requirement
disable_mlock = true
