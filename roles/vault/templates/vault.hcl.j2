# Managed by Ansible - Vault server configuration

ui = true

cluster_name = "homelab-vault"

{#
  Use the effective public URL computed by the role (typically https://<IP>:8200)
  to avoid relying on base_domain/FQDN inside the container.
#}
api_addr = "{{ vault_public_url_effective | trim | replace('"','\\"') }}"
{# Derive hostname/IP from public URL without relying on urlsplit (portable) #}
{% set _pub_host = (vault_public_url_effective | regex_replace('^https?://', '') | regex_replace(':\\d+/?$', '') | trim('/') ) %}
cluster_addr = "https://{{ _pub_host | trim | replace('"','\\"') }}:{{ vault_cluster_port }}"

{% if vault_enable_transit_seal | default(false) %}
seal "transit" {
  {# Use explicit IP for the bootstrap transit provider #}
  {% set _bootstrap_host = (groups['vault_bootstrap'] | default([])) | length > 0 and (groups['vault_bootstrap'][0]) or 'rpi5b8g1' %}
  {% set _bootstrap_ip = hostvars[_bootstrap_host].ansible_host | default(hostvars[_bootstrap_host].ansible_facts.default_ipv4.address) %}
  address         = "https://{{ _bootstrap_ip }}:{{ vault_api_port }}"
  {# Read the transit token directly from the controller file and sanitize quotes/newlines #}
  {% set _transit_token = lookup('file', (vault_transit_token_export_path | default('~/.local/share/ansible-home-cluster/vault/transit_token.txt')) | expanduser) | trim | replace('"','\\"') %}
  token           = "{{ _transit_token }}"
  key_name        = "{{ (vault_transit_key_name | default('autounseal')) | trim | replace('"','\\"') }}"
  mount_path      = "{{ (vault_transit_mount_path | default('transit/')) | trim | replace('"','\\"') }}"
  tls_skip_verify = {{ (vault_transit_tls_skip_verify | default(false)) | ternary('true','false') }}
}
{% endif %}

storage "raft" {
path    = "{{ vault_data_dir_in_container }}"

{#
    Build retry_join only on non-leader nodes and target the designated raft leader
    (first host in vault_cluster group) by IP. The leader itself renders no retry_join.
  #}
{% set leader_host = (groups['vault_leader'] | default([])) | length > 0 and (groups['vault_leader'][0]) or inventory_hostname %}
{% if inventory_hostname != leader_host %}
    retry_join {
    # Target the Raft leader API address (use IP to avoid DNS dependency)
    {% set _leader_ip = hostvars[leader_host].ansible_host | default(hostvars[leader_host].ansible_facts.default_ipv4.address) %}
    leader_api_addr       = "https://{{ _leader_ip }}:{{ vault_api_port }}"
    # Verify the leader's certificate against our cluster CA and set SNI to the leader IP
    leader_tls_servername = "{{ _leader_ip }}"
    leader_ca_cert_file   = "{{ vault_tls_dir_in_container }}/cluster-ca.pem"
    leader_client_cert_file = ""
    leader_client_key_file  = ""
    leader_tls_skip_verify = false
    }
{% endif %}
}

listener "tcp" {
address         = "{{ vault_listener_address | default(vault_bind_ip) }}:{{ vault_api_port }}"
tls_disable     = 0
tls_cert_file   = "{{ vault_tls_cert_path }}"
tls_key_file    = "{{ vault_tls_key_path }}"
# Trust our cluster CA for inbound client verification when clients present certs
# (not enabling mTLS by default; this only supplies CA chain for verification where applicable)
tls_client_ca_file = "{{ vault_tls_dir_in_container }}/cluster-ca.pem"
}

telemetry {
prometheus_retention_time = "12h"
}

# Explicitly set disable_mlock to satisfy Vault >=1.20 requirement
disable_mlock = true
