# Managed by Ansible - Vault server configuration

ui = true

cluster_name = "homelab-vault"

api_addr = "https://{{ inventory_hostname }}.{{ base_domain }}:{{ vault_api_port }}"
cluster_addr = "https://{{ inventory_hostname }}.{{ base_domain }}:{{ vault_cluster_port }}"

storage "raft" {
path    = "{{ vault_data_dir }}"
node_id = "{{ inventory_hostname }}"

{#
    Build retry_join targets.
    Prefer explicit vault_raft_peers if provided; otherwise derive peers as all
    other hosts in the vault_cluster inventory group. This ensures peers have
    at least the leader in their retry list without requiring extra variables.
  #}
{% set derived_peers = (groups['vault_cluster'] | default([])) | difference([inventory_hostname]) %}
{% set join_peers = vault_raft_peers | default(derived_peers) %}
{% for peer in join_peers %}
    retry_join {
    # Connect to peer using FQDN; container extra_hosts maps FQDN -> LAN IP
    leader_api_addr       = "https://{{ peer }}.{{ base_domain }}:{{ vault_api_port }}"
    leader_tls_servername = "{{ peer }}.{{ base_domain }}"
    leader_ca_cert_file   = "{{ vault_tls_dir_in_container }}/cluster-ca.crt"
    }
{% endfor %}
}

listener "tcp" {
address         = "{{ vault_listener_address | default(vault_bind_ip) }}:{{ vault_api_port }}"
tls_disable     = 0
tls_cert_file   = "{{ vault_tls_cert_path }}"
tls_key_file    = "{{ vault_tls_key_path }}"
}

telemetry {
prometheus_retention_time = "12h"
}
