#!/usr/bin/nft -f
# vim:set ts=2 sw=2 et:

############################
# Base firewall ruleset
############################

destroy table inet filter

table inet filter {

################
# INPUT (to host)
################
chain input {
type filter hook input priority filter; policy drop;

# Drop broken traffic early
ct state invalid drop

# Allow established connections
ct state { established, related } accept

# Allow loopback
iif lo accept

# FULL TRUST: LAN, Podman and K3s
ip saddr { {{ lan_subnet }}, {{ podman_subnet }}, {{ k3s_cluster_cidr }}, {{ k3s_service_cidr }} } accept

# Diagnostics (optional but sane)
ip protocol icmp accept
meta l4proto ipv6-icmp accept
}

###################
# FORWARD (routing)
###################
chain forward {
type filter hook forward priority filter; policy drop;

# FULL TRUST: LAN, Podman and K3s
ip saddr { {{ lan_subnet }}, {{ podman_subnet }}, {{ k3s_cluster_cidr }}, {{ k3s_service_cidr }} } accept
ip daddr { {{ lan_subnet }}, {{ podman_subnet }}, {{ k3s_cluster_cidr }}, {{ k3s_service_cidr }} } accept

# Allow established/related forwarded traffic (for container egress return paths)
ct state { established, related } accept

# Allow DNS egress for Podman containers to the internet (UDP/TCP 53)
ip saddr {{ podman_subnet }} udp dport 53 accept
ip saddr {{ podman_subnet }} tcp dport 53 accept
}

#################
# OUTPUT (host)
#################
chain output {
type filter hook output priority filter; policy accept;

# Allow DNS egress for Podman and K3s containers
ip saddr { {{ podman_subnet }}, {{ k3s_cluster_cidr }} } udp dport 53 accept
ip saddr { {{ podman_subnet }}, {{ k3s_cluster_cidr }} } tcp dport 53 accept
}
}

# Note: NAT (SNAT/MASQUERADE) for Podman is managed by Netavark/iptables-nft.
# Do not duplicate NAT rules here to avoid conflicts.

