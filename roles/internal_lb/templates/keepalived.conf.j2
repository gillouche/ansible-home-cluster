vrrp_script check_haproxy_lb {
  script "/usr/bin/curl --silent --fail http://127.0.0.1:8404/stats"
  interval 2
  weight -60
  rise 2
  fall 2
}

vrrp_instance VI_LoadBalancer {
  state {{ vrrp_state }}
  interface {{ vrrp_interface }}
  virtual_router_id {{ virtual_router_id }}
  priority {{ vrrp_priority }}
  advert_int 1

  # Prevent "flapping" by not automatically pre-empting a lower priority master
  # if this node has higher priority but just came online.
  # nopreempt

  authentication {
    auth_type PASS
    auth_pass {{ vrrp_auth_pass }}
  }

  virtual_ipaddress {
    {{ vip_address }}/{{ load_balancer_vip_prefixlen }}
  }

  track_interface {
    {{ vrrp_interface }}
  }

  track_script {
    check_haproxy_lb
  }

  notify "/usr/local/bin/keepalived_notify.sh"
}
