apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cert-manager
  namespace: kube-system
spec:
  repo: https://charts.jetstack.io
  chart: cert-manager
  version: {{ cert_manager_version }}
  targetNamespace: {{ cert_manager_namespace }}
  createNamespace: true
  valuesContent: |
    installCRDs: true
    prometheus:
      enabled: false
