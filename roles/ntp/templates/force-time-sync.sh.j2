#!/bin/bash
# Managed by Ansible

echo "Stopping ntpd if running..."
systemctl stop ntpd || true

echo "Attempting SNTP sync..."
# Try up to 3 times for SNTP
for i in {1..3}; do
    echo "SNTP attempt $i..."
    timeout 20s sntp -S pool.ntp.org && { echo "SNTP sync successful."; exit 0; }
    sleep 5
done

echo "SNTP failed, attempting HTTP fallback..."
# Try up to 3 times for HTTP fallback
for i in {1..3}; do
    echo "HTTP attempt $i..."
    HTTP_DATE=$(curl -s --head --connect-timeout 5 http://google.com | grep ^Date: | sed 's/Date: //g')
    if [ -n "$HTTP_DATE" ]; then
        echo "Setting date from HTTP: $HTTP_DATE"
        date -s "$HTTP_DATE"
        exit 0
    fi
    sleep 5
done

echo "HTTP fallback failed."
exit 1
