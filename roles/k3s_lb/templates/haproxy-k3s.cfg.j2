defaults
  log     global
  mode    tcp
  option  tcplog
  timeout connect 5s
  timeout client  1m
  timeout server  1m

listen stats
  bind 127.0.0.1:8404
  mode http
  stats enable
  stats uri /stats
  stats refresh 10s
  stats admin if LOCALHOST

# Custom configurations from conf.dlisten k3s_api
    bind {{ k3s_api_vip }}:6443
    mode tcp
    option tcplog
    default-server inter 5s fall 2 rise 1
{% for host in groups['server'] | sort %}
    server {{ host }} {{ hostvars[host].ansible_host }}:6443 check check-ssl verify none
{% endfor %}
