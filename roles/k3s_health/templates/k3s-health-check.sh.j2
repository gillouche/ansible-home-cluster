#!/bin/bash
# K3s health check — restarts k3s if containerd or kubelet is unhealthy.
# Checks: containerd responsiveness, kubelet health endpoint, stuck pods.
# Deployed by Ansible (k3s_health role).

set -euo pipefail

SERVICE_NAME="{{ k3s_service_name }}"
HOSTNAME=$(hostname)
COOLDOWN_FILE="/tmp/k3s-health-restart-cooldown"
RESTART_MARKER="/tmp/k3s-health-restart-attempted"
COOLDOWN_SECONDS=300
POST_RESTART_GRACE=180
STUCK_POD_THRESHOLD=600

healthy=true
reason=""

if ! k3s ctr --connect-timeout 5s containers list >/dev/null 2>&1; then
    healthy=false
    reason="containerd unresponsive"
fi

if $healthy; then
    kubelet_status=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:10248/healthz 2>/dev/null || echo "000")
    if [ "$kubelet_status" != "200" ]; then
        healthy=false
        reason="kubelet healthz returned $kubelet_status"
    fi
fi

if $healthy; then
    stuck_pods=$(k3s kubectl get pods --all-namespaces --field-selector "spec.nodeName=$HOSTNAME,status.phase=Pending" -o jsonpath='{range .items[*]}{.metadata.name} {.metadata.creationTimestamp}{"\n"}{end}' 2>/dev/null || true)
    if [ -n "$stuck_pods" ]; then
        now=$(date +%s)
        while IFS=' ' read -r pod_name created; do
            [ -z "$pod_name" ] && continue
            created_epoch=$(date -d "$created" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$created" +%s 2>/dev/null || echo 0)
            if (( created_epoch > 0 && now - created_epoch > STUCK_POD_THRESHOLD )); then
                healthy=false
                reason="pod $pod_name stuck in Pending for over $((STUCK_POD_THRESHOLD / 60))m on this node"
                break
            fi
        done <<< "$stuck_pods"
    fi
fi

if $healthy; then
    rm -f "$RESTART_MARKER"
    exit 0
fi

now=$(date +%s)

if [ -f "$COOLDOWN_FILE" ]; then
    last_action=$(cat "$COOLDOWN_FILE")
    if (( now - last_action < COOLDOWN_SECONDS )); then
        exit 0
    fi
fi

if [ -f "$RESTART_MARKER" ]; then
    restart_time=$(cat "$RESTART_MARKER")
    if (( now - restart_time > POST_RESTART_GRACE )); then
        logger -t k3s-health -p user.crit "CRITICAL: $reason — still unhealthy after $SERVICE_NAME restart on $HOSTNAME, manual intervention required"
        date +%s > "$COOLDOWN_FILE"
    fi
    exit 0
fi

logger -t k3s-health -p user.warning "$reason on $HOSTNAME, restarting $SERVICE_NAME"
date +%s > "$COOLDOWN_FILE"
date +%s > "$RESTART_MARKER"
systemctl restart "$SERVICE_NAME"
