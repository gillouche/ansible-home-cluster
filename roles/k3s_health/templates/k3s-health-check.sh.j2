#!/bin/bash
# K3s health check — detects and recovers from common k3s/containerd failures.
# Checks: containerd responsiveness, kubelet health endpoint, API server reachability,
#         node heartbeat freshness, node Ready status, stuck Pending pods,
#         CreateContainerError pods (stale containerd name reservations).
# Recovery escalation: force-delete pods -> restart k3s -> reboot -> alert.
# Deployed by Ansible (k3s_health role).

set -euo pipefail

SERVICE_NAME="{{ k3s_service_name }}"
HOSTNAME=$(hostname)
STATE_DIR="/var/lib/k3s-health"
COOLDOWN_FILE="$STATE_DIR/restart-cooldown"
RESTART_MARKER="$STATE_DIR/restart-attempted"
REBOOT_MARKER="$STATE_DIR/reboot-attempted"
POD_DELETE_MARKER="$STATE_DIR/pod-delete-attempted"
COOLDOWN_SECONDS=120
POST_RESTART_GRACE=180
STUCK_POD_THRESHOLD=600
CREATE_ERROR_MIN_COUNT=3
HEARTBEAT_STALE_THRESHOLD=180

mkdir -p "$STATE_DIR"

healthy=true
reason=""
action="restart"

if ! k3s ctr --connect-timeout 5s containers list >/dev/null 2>&1; then
    healthy=false
    reason="containerd unresponsive"
fi

if $healthy; then
    kubelet_status=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:10248/healthz 2>/dev/null || echo "000")
    if [ "$kubelet_status" != "200" ]; then
        healthy=false
        reason="kubelet healthz returned $kubelet_status"
    fi
fi

if $healthy; then
    if ! k3s kubectl get node "$HOSTNAME" --request-timeout=5s >/dev/null 2>&1; then
        healthy=false
        reason="kubectl unable to reach API server from $HOSTNAME"
    fi
fi

if $healthy; then
    heartbeat=$(k3s kubectl get node "$HOSTNAME" \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].lastHeartbeatTime}' \
        --request-timeout=5s 2>/dev/null || echo "")
    if [ -n "$heartbeat" ]; then
        heartbeat_epoch=$(date -d "$heartbeat" +%s 2>/dev/null || echo 0)
        now_epoch=$(date +%s)
        if (( heartbeat_epoch > 0 && now_epoch - heartbeat_epoch > HEARTBEAT_STALE_THRESHOLD )); then
            healthy=false
            reason="node heartbeat stale ($((now_epoch - heartbeat_epoch))s old, threshold ${HEARTBEAT_STALE_THRESHOLD}s)"
        fi
    fi
fi

if $healthy; then
    node_ready=$(k3s kubectl get node "$HOSTNAME" \
        -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' \
        --request-timeout=5s 2>/dev/null || echo "Unknown")
    if [ "$node_ready" != "True" ]; then
        healthy=false
        reason="node $HOSTNAME reports Ready=$node_ready despite healthy kubelet"
    fi
fi

if $healthy; then
    stuck_pods=$(k3s kubectl get pods --all-namespaces --field-selector "spec.nodeName=$HOSTNAME,status.phase=Pending" -o jsonpath='{range .items[*]}{.metadata.name} {.metadata.creationTimestamp}{"\n"}{end}' 2>/dev/null || true)
    if [ -n "$stuck_pods" ]; then
        now=$(date +%s)
        while IFS=' ' read -r pod_name created; do
            [ -z "$pod_name" ] && continue
            created_epoch=$(date -d "$created" +%s 2>/dev/null || echo 0)
            if (( created_epoch > 0 && now - created_epoch > STUCK_POD_THRESHOLD )); then
                healthy=false
                reason="pod $pod_name stuck in Pending for over $((STUCK_POD_THRESHOLD / 60))m on this node"
                break
            fi
        done <<< "$stuck_pods"
    fi
fi

if $healthy; then
    error_count=$(k3s kubectl get pods --all-namespaces --field-selector "spec.nodeName=$HOSTNAME" \
        -o jsonpath='{range .items[*]}{range .status.containerStatuses[*]}{.state.waiting.reason}{"\n"}{end}{end}' 2>/dev/null \
        | grep -c "CreateContainerError" || true)
    if (( error_count >= CREATE_ERROR_MIN_COUNT )); then
        healthy=false
        action="fix_create_error"
        reason="$error_count pods stuck in CreateContainerError (stale containerd state)"
    fi
fi

if $healthy; then
    rm -f "$RESTART_MARKER" "$REBOOT_MARKER" "$POD_DELETE_MARKER"
    exit 0
fi

now=$(date +%s)

if [ -f "$COOLDOWN_FILE" ]; then
    last_action=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
    if (( now - last_action < COOLDOWN_SECONDS )); then
        exit 0
    fi
fi

if [ "$action" = "fix_create_error" ]; then
    if [ ! -f "$POD_DELETE_MARKER" ]; then
        logger -t k3s-health -p user.warning "$reason on $HOSTNAME, restarting $SERVICE_NAME and cleaning up stuck pods"
        date +%s > "$POD_DELETE_MARKER"
        date +%s > "$COOLDOWN_FILE"
        systemctl restart "$SERVICE_NAME"
        sleep 30
        k3s kubectl get pods --all-namespaces --field-selector "spec.nodeName=$HOSTNAME" \
            -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name} {range .status.containerStatuses[*]}{.state.waiting.reason}{end}{"\n"}{end}' 2>/dev/null \
            | grep "CreateContainerError" \
            | while IFS=' ' read -r ns pod_name _reason; do
                [ -z "$pod_name" ] && continue
                k3s kubectl delete pod "$pod_name" -n "$ns" --force --grace-period=0 2>/dev/null || true
            done
        exit 0
    fi

    if [ ! -f "$REBOOT_MARKER" ]; then
        logger -t k3s-health -p user.crit "$reason on $HOSTNAME after restart + cleanup, rebooting node"
        date +%s > "$COOLDOWN_FILE"
        date +%s > "$REBOOT_MARKER"
        reboot
        exit 0
    fi

    logger -t k3s-health -p user.crit "CRITICAL: $reason on $HOSTNAME — reboot already attempted, manual intervention required"
    date +%s > "$COOLDOWN_FILE"
    exit 0
fi

if [ -f "$RESTART_MARKER" ]; then
    restart_time=$(cat "$RESTART_MARKER" 2>/dev/null || echo 0)
    if (( now - restart_time > POST_RESTART_GRACE )); then
        logger -t k3s-health -p user.crit "CRITICAL: $reason — still unhealthy after $SERVICE_NAME restart on $HOSTNAME, manual intervention required"
        date +%s > "$COOLDOWN_FILE"
    fi
    exit 0
fi

logger -t k3s-health -p user.warning "$reason on $HOSTNAME, restarting $SERVICE_NAME"
date +%s > "$COOLDOWN_FILE"
date +%s > "$RESTART_MARKER"
systemctl restart "$SERVICE_NAME"
