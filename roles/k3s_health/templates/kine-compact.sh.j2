#!/usr/bin/env bash
set -euo pipefail

CONTAINER_NAME="postgres"
DB_USER="postgres"
DB_NAME="kubernetes"
MAX_TABLE_SIZE_MB=500
LOG_TAG="kine-compact"

log() { logger -t "$LOG_TAG" "$@"; }

if ! podman inspect "$CONTAINER_NAME" &>/dev/null; then
  exit 0
fi

is_leader=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT pg_is_in_recovery();" 2>/dev/null || echo "t")

if [[ "$is_leader" == "t" ]]; then
  exit 0
fi

row_count=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT count(*) FROM kine;" 2>/dev/null || echo "0")

table_size_mb=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT pg_total_relation_size('kine') / 1024 / 1024;" 2>/dev/null || echo "0")

log "kine table: ${row_count} rows, ${table_size_mb} MB"

unique_keys=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT count(DISTINCT name) FROM kine;" 2>/dev/null || echo "0")

event_count=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT count(*) FROM kine WHERE name LIKE '/registry/events/%';" 2>/dev/null || echo "0")

stale_rows=$(( row_count - unique_keys ))

if (( stale_rows < 10000 && table_size_mb < MAX_TABLE_SIZE_MB && event_count < 50000 )); then
  log "kine table healthy (${stale_rows} stale rows, ${table_size_mb} MB, ${event_count} events), skipping compaction"
  exit 0
fi

if (( event_count > 50000 )); then
  log "pruning ${event_count} old events"
  podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -c "
    SET statement_timeout = '300s';
    DELETE FROM kine WHERE name LIKE '/registry/events/%';
  " 2>/dev/null || true
fi

log "compacting kine: ${stale_rows} stale rows to remove"

for prefix in '/registry/leases/' '/registry/events/' '/registry/'; do
  deleted=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc "
    SET statement_timeout = '300s';
    WITH latest AS (
      SELECT name, max(id) as max_id
      FROM kine
      WHERE name LIKE '${prefix}%'
      GROUP BY name
    )
    DELETE FROM kine k USING latest l
    WHERE k.name = l.name AND k.id < l.max_id;
  " 2>/dev/null || echo "0")

  deleted_count=$(echo "$deleted" | grep -oP '\d+' || echo "0")
  log "compacted prefix '${prefix}': ${deleted_count} rows deleted"

  if [[ "$prefix" == "/registry/" ]]; then
    break
  fi
done

new_size_mb=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
  "SELECT pg_total_relation_size('kine') / 1024 / 1024;" 2>/dev/null || echo "0")

if (( new_size_mb > MAX_TABLE_SIZE_MB * 2 )); then
  log "table still large (${new_size_mb} MB), running VACUUM FULL"
  podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -c "VACUUM FULL kine;" 2>/dev/null
  final_size_mb=$(podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -tAc \
    "SELECT pg_total_relation_size('kine') / 1024 / 1024;" 2>/dev/null || echo "0")
  log "VACUUM FULL complete: ${final_size_mb} MB"
else
  podman exec "$CONTAINER_NAME" psql -U "$DB_USER" -d "$DB_NAME" -c "VACUUM ANALYZE kine;" 2>/dev/null
  log "VACUUM ANALYZE complete: ${new_size_mb} MB"
fi
