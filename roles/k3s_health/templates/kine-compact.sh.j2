#!/usr/bin/env bash
set -euo pipefail

PG_CONTAINER="{{ postgres_container_name | default('postgres') }}"
PG_USER="{{ k3s_db_user | default('k3s') }}"
PG_DB="{{ k3s_db_name | default('kubernetes') }}"
PG_PASSWORD="{{ k3s_db_password | default('k3s-db-changeme') }}"
MAX_TABLE_SIZE_MB=500
LOG_TAG="kine-compact"

log() { logger -t "$LOG_TAG" "$@"; }

psql_cmd() {
  podman exec -e PGPASSWORD="$PG_PASSWORD" "$PG_CONTAINER" \
    psql -U "$PG_USER" -d "$PG_DB" "$@"
}

psql_query() {
  psql_cmd -tAc "$1" 2>/dev/null || echo "0"
}

if ! psql_cmd -c "SELECT 1;" &>/dev/null; then
  log "Cannot connect to Postgres container ${PG_CONTAINER}, skipping"
  exit 0
fi

row_count=$(psql_query "SELECT count(*) FROM kine;")
table_size_mb=$(psql_query "SELECT pg_total_relation_size('kine') / 1024 / 1024;")
unique_keys=$(psql_query "SELECT count(DISTINCT name) FROM kine;")
event_count=$(psql_query "SELECT count(*) FROM kine WHERE name LIKE '/registry/events/%';")

stale_rows=$(( row_count - unique_keys ))
log "kine table: ${row_count} rows, ${table_size_mb} MB, ${stale_rows} stale, ${event_count} events"

if (( stale_rows < 10000 && table_size_mb < MAX_TABLE_SIZE_MB && event_count < 50000 )); then
  log "kine table healthy, skipping compaction"
  exit 0
fi

if (( event_count > 50000 )); then
  log "pruning ${event_count} old events"
  psql_cmd -c "
    SET statement_timeout = '300s';
    DELETE FROM kine WHERE name LIKE '/registry/events/%';
  " 2>/dev/null || true
fi

log "compacting kine: ${stale_rows} stale rows to remove"

for prefix in '/registry/leases/' '/registry/events/' '/registry/'; do
  deleted=$(psql_cmd -tAc "
    SET statement_timeout = '300s';
    WITH latest AS (
      SELECT name, max(id) as max_id
      FROM kine
      WHERE name LIKE '${prefix}%'
      GROUP BY name
    )
    DELETE FROM kine k USING latest l
    WHERE k.name = l.name AND k.id < l.max_id;
  " 2>/dev/null || echo "0")

  deleted_count=$(echo "$deleted" | grep -oP '\d+' || echo "0")
  log "compacted prefix '${prefix}': ${deleted_count} rows deleted"

  if [[ "$prefix" == "/registry/" ]]; then
    break
  fi
done

new_size_mb=$(psql_query "SELECT pg_total_relation_size('kine') / 1024 / 1024;")

if (( new_size_mb > MAX_TABLE_SIZE_MB )); then
  log "table large (${new_size_mb} MB > ${MAX_TABLE_SIZE_MB} MB), running VACUUM FULL"
  psql_cmd -c "VACUUM FULL kine;" 2>/dev/null
  final_size_mb=$(psql_query "SELECT pg_total_relation_size('kine') / 1024 / 1024;")
  log "VACUUM FULL complete: ${final_size_mb} MB"
else
  psql_cmd -c "VACUUM ANALYZE kine;" 2>/dev/null
  log "VACUUM ANALYZE complete: ${new_size_mb} MB"
fi
