vrrp_script check_pihole {
  script "/usr/bin/podman healthcheck run pihole || /usr/bin/pgrep -f pihole"
  interval 3
  weight -60
  rise 2
  fall 3
}

vrrp_instance VI_Pihole {
  state {{ vrrp_state }}
  interface {{ vrrp_interface }}
  virtual_router_id 51
  priority {{ vrrp_priority }}
  advert_int 1

  authentication {
    auth_type PASS
    auth_pass {{ vrrp_auth_pass }}
  }

  virtual_ipaddress {
    {{ vip_address }}/{{ pihole_vip_prefixlen }}
  }

  track_interface {
    {{ vrrp_interface }}
  }

  track_script {
    check_pihole
  }

  notify "/usr/local/bin/keepalived_notify.sh"
}
