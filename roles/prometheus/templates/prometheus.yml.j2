global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ host }}:{{ prometheus_node_exporter_port }}']
        labels:
          __address_ip__: "{{ hostvars[host].ansible_host }}"
          cluster: "k3s"
{% endfor %}
    relabel_configs:
      - source_labels: [__address_ip__]
        target_label: __address__
        replacement: "${1}:{{ prometheus_node_exporter_port }}"

  - job_name: 'loki'
    static_configs:
{% for host in groups['loki'] %}
      - targets: ['{{ host }}:{{ loki_port | default(3100) }}']
        labels:
          __address_ip__: "{{ hostvars[host].ansible_host }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address_ip__]
        target_label: __address__
        replacement: "${1}:{{ loki_port | default(3100) }}"

  - job_name: 'promtail'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ host }}:{{ hostvars[host].loki_promtail_http_listen_port | default(9080) }}']
        labels:
          __address_ip__: "{{ hostvars[host].ansible_host }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address_ip__]
        target_label: __address__
        replacement: "${1}:{{ loki_promtail_http_listen_port | default(9080) }}"

  - job_name: 'kube-state-metrics'
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/ca-bundle.pem
    static_configs:
      - targets: ['ksm.k3s.{{ base_domain }}:443']
        labels:
          cluster: "k3s"

{% if _prometheus_k3s_token_local is defined and _prometheus_k3s_token_local.stat.exists %}
  - job_name: 'kubernetes-nodes'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token_file: /etc/prometheus/k3s_token
    kubernetes_sd_configs:
      - role: node
        api_server: https://{{ k3s_api_vip }}:6443
        tls_config:
          insecure_skip_verify: true
        bearer_token_file: /etc/prometheus/k3s_token
    relabel_configs:
      - action: labelmap
        regex: __meta_kubernetes_node_label_(.+)
      - target_label: cluster
        replacement: k3s
      - source_labels: [__meta_kubernetes_node_name]
        target_label: node
      - target_label: __address__
        replacement: {{ k3s_api_vip }}:6443
      - source_labels: [__meta_kubernetes_node_name]
        regex: (.+)
        target_label: __metrics_path__
        replacement: /api/v1/nodes/${1}/proxy/metrics

  - job_name: 'kubernetes-nodes-cadvisor'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token_file: /etc/prometheus/k3s_token
    kubernetes_sd_configs:
      - role: node
        api_server: https://{{ k3s_api_vip }}:6443
        tls_config:
          insecure_skip_verify: true
        bearer_token_file: /etc/prometheus/k3s_token
    relabel_configs:
      - action: labelmap
        regex: __meta_kubernetes_node_label_(.+)
      - target_label: cluster
        replacement: k3s
      - source_labels: [__meta_kubernetes_node_name]
        target_label: node
      - target_label: __address__
        replacement: {{ k3s_api_vip }}:6443
      - source_labels: [__meta_kubernetes_node_name]
        regex: (.+)
        target_label: __metrics_path__
        replacement: /api/v1/nodes/${1}/proxy/metrics/cadvisor
{% endif %}
