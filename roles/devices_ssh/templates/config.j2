# Generated by Ansible devices_ssh for {{ devices_ssh_user }}
{% for peer in (devices_ssh_peer_group | difference([inventory_hostname]) | default([])) %}
Host {{ peer }}
    HostName {{ hostvars[peer].ansible_host | default(peer) }}
    User {{ devices_ssh_user }}
    IdentityFile ~/.ssh/id_ed25519
    StrictHostKeyChecking accept-new

{% endfor %}
