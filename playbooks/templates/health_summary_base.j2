{% import "health_summary_macros.j2" as macros with context %}
================================================================================
{{ macros.BOLD }}                      HOMELAB: BASE INFRASTRUCTURE REPORT{{ macros.RESET }}
================================================================================

################################################################################
{{ macros.BOLD }}[ SECTION 1: DEVICES & BASE INFRASTRUCTURE ]{{ macros.RESET }}
################################################################################

{{ macros.BOLD }}[ SYSTEM CLOCK ]{{ macros.RESET }}
{% if groups['all'] | map('extract', hostvars, '_device_time') | select('defined') | list | length > 0 %}
{% for host in groups['all'] | sort %}
  {{ macros.CYAN }}> {{ host }}{{ macros.RESET }}
    Status:        {{
      macros.ok('SYNCHRONIZED')
      if (hostvars[host]['_device_time'].stdout | default(0) | int) >= (hostvars['localhost']['_controller_time'].stdout | default(9999999999) | int)
      else macros.bad('DRIFT DETECTED')
    }}
    Offset:        {{ (hostvars[host]['_device_time'].stdout | default(0) | int) - (hostvars['localhost']['_controller_time'].stdout | default(0) | int) }}s relative to Controller
{% endfor %}
{% endif %}



{{ macros.BOLD }}[ CERTIFICATES ]{{ macros.RESET }}
{% if groups['all'] | map('extract', hostvars, '_root_ca_days_remaining') | select('defined') | list | length > 0 %}
{% for host in groups['all'] | sort %}
{% if hostvars[host]['_root_ca_days_remaining'] is defined %}
  {{ macros.CYAN }}> {{ host }}{{ macros.RESET }}
    Root CA Trust: {{
      macros.ok(hostvars[host]['_root_ca_days_remaining'] ~ ' days')
      if (hostvars[host]['_root_ca_days_remaining'] | int) > 90
      else (macros.cyan(hostvars[host]['_root_ca_days_remaining'] ~ ' days') if (hostvars[host]['_root_ca_days_remaining'] | int) > 30 else macros.bad(hostvars[host]['_root_ca_days_remaining'] ~ ' days'))
    }}
{% endif %}
{% if hostvars[host]['_wildcard_cert_days_remaining'] is defined %}
    Wildcard Cert: {{
      macros.ok(hostvars[host]['_wildcard_cert_days_remaining'] ~ ' days')
      if (hostvars[host]['_wildcard_cert_days_remaining'] | int) > 90
      else (macros.cyan(hostvars[host]['_wildcard_cert_days_remaining'] ~ ' days') if (hostvars[host]['_wildcard_cert_days_remaining'] | int) > 30 else macros.bad(hostvars[host]['_wildcard_cert_days_remaining'] ~ ' days'))
    }}
{% endif %}
{% endfor %}
{% endif %}


{{ macros.BOLD }}[ PI-HOLE DNS ]{{ macros.RESET }}
{% if groups['dns_cluster'] | map('extract', hostvars, '_pihole_vip_dns_check') | select('defined') | list | length > 0 %}
{% for host in groups['dns_cluster'] | sort %}
  {{ macros.CYAN }}> {{ host }}{{ macros.RESET }}
    VIP ({{ pihole_virtual_ip | default('N/A') }}):   {{
      macros.ok('SUCCESS')
      if hostvars[host]._pihole_vip_dns_check.rc | default(-1) == 0
         and hostvars[host]._pihole_vip_dns_check.stdout | default('') != ''
      else macros.bad('FAILED')
    }}
    Local (127.0.0.1):      {{
      macros.ok('SUCCESS')
      if hostvars[host]._pihole_local_dns_check.rc | default(-1) == 0
         and hostvars[host]._pihole_local_dns_check.stdout | default('') != ''
      else macros.bad('FAILED')
    }}
{% endfor %}
{% endif %}

{{ macros.BOLD }}[ BASE WORKLOADS (Proxy, Nexus, Firefly) ]{{ macros.RESET }}
{% set proxy_data = groups['edge_proxy_cluster'] | map('extract', hostvars, '_proxy_wildcard_stat') | select('defined') | list %}
{% set nexus_data = groups['artifactory'] | map('extract', hostvars, '_nexus_status') | select('defined') | list %}
{% set firefly_data = groups['firefly'] | map('extract', hostvars, '_firefly_health') | select('defined') | list %}
{% if proxy_data | length > 0 or nexus_data | length > 0 or firefly_data | length > 0 %}
{% for host in groups['edge_proxy_cluster'] | sort %}
  {{ macros.CYAN }}> Edge Proxy: {{ host }}{{ macros.RESET }}
    Wildcard Cert:     {{ macros.ok('PRESENT') if hostvars[host]._proxy_wildcard_stat.stat.exists | default(false) else macros.bad('MISSING') }}

    VIP Active:        {{ macros.ok('YES') if hostvars[host]._proxy_has_vip | default(false) else macros.cyan('NO (Backup)') }}
{% endfor %}
{% for host in groups['artifactory'] | sort %}
  {{ macros.CYAN }}> Nexus: {{ host }}{{ macros.RESET }}
    Status:           {{ macros.ok('HEALTHY') if hostvars[host]._nexus_status.status | default(0) == 200 else macros.bad('DOWN') }}
{% endfor %}
{% for host in groups['firefly'] | sort %}
  {{ macros.CYAN }}> Firefly III: {{ host }}{{ macros.RESET }}
    Status:           {{ macros.ok('UP') if hostvars[host]._firefly_health.status | default(0) in [200, 302] else macros.bad('DOWN') }}
{% endfor %}
{% endif %}



################################################################################
{{ macros.BOLD }}[ EXTERNAL ACCESS & SERVICES (Base) ]{{ macros.RESET }}
################################################################################

{{ macros.BOLD }}[ EXTERNAL ACCESS (via {{ reverse_proxy_virtual_ip }}) ]{{ macros.RESET }}
  {{ macros.CYAN }}-- Base Infrastructure --{{ macros.RESET }}

  Firefly (HTTPS):      {{ macros.ok('UP') if (_external_firefly_ready.status | default(-1)) == 200 or (_external_firefly_login_ready.status | default(-1)) in [200, 302] else macros.bad('DOWN') }}
  Nexus (HTTPS):        {{ macros.ok('UP') if (_external_nexus_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Pi-hole Pri (HTTPS):  {{ macros.ok('UP') if (_external_pihole_primary_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Pi-hole Rep1 (HTTPS): {{ macros.ok('UP') if (_external_pihole_replica1_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Pi-hole Rep2 (HTTPS): {{ macros.ok('UP') if (_external_pihole_replica2_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}

