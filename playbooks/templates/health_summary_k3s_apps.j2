  Loki (HTTPS):         {{ macros.ok('UP') if (_external_loki_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Grafana (HTTPS):      {{ macros.ok('UP') if (_external_grafana_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Longhorn (HTTPS):     {{ macros.ok('UP') if (_external_longhorn_ui_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Dashboard (HTTPS):    {{ macros.ok('UP') if (_external_dashboard_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Homepage (HTTPS):     {{ macros.ok('UP') if (_external_homepage_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Seaweed Filer (HTTPS): {{ macros.ok('UP') if (_external_seaweed_filer_ready.status | default(-1)) == 200 else macros.bad('DOWN') }}
  Seaweed S3 (HTTPS):    {{ macros.ok('UP') if (_external_seaweed_s3_ready.status | default(-1)) in [200, 403] else macros.bad('DOWN') }}

